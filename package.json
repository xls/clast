{
  "name": "clast-ai",
  "version": "0.1.2",
  "description": "AST-based code intelligence plugin for Claude Code: search symbols, trace call graphs, generate comments, and provide structured context for any repository",
  "main": "dist/server/index.js",
  "bin": {
    "clast-ai": "dist/server/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ast",
    "code-intelligence",
    "call-graph",
    "tree-sitter",
    "mcp",
    "claude-code",
    "plugin"
  ],
  "author": "trizos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xls/clast.git"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "commands",
    ".claude-plugin",
    ".mcp.json",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "chokidar": "^6.0.0",
    "ignore": "^7.0.14",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
