{
  "name": "clast-ai",
  "version": "0.3.1",
  "description": "Code index MCP server for coding agents (Claude Code, Codex, Gemini CLI, any MCP client): symbol search, type-aware call graph, hierarchy, change impact, dead code and exact counts",
  "main": "dist/engine.js",
  "bin": {
    "clast-ai": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "bench": "node bench/bench.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ast",
    "code-intelligence",
    "call-graph",
    "tree-sitter",
    "mcp",
    "claude-code",
    "plugin"
  ],
  "author": "trizos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xls/clast.git"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "plugin",
    ".claude-plugin",
    "bench",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "chokidar": "^6.0.0",
    "ignore": "^7.0.14",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
